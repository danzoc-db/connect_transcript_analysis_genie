# TEMPLATE ONLY. This file is deliberately outside .github/workflows so it never runs in this
# public repository, which is not connected to any Databricks workspace.
#
# To deploy from your own private fork:
#   1. Copy this file to .github/workflows/deploy.yml.
#   2. Configure GitHub OIDC workload identity federation for a deploy service principal
#      (no stored client secret). See docs/GETTING_STARTED.md.
#   3. Set repository variables DATABRICKS_HOST, DATABRICKS_CLIENT_ID,
#      DATABRICKS_RUNTIME_CLIENT_ID and DATABRICKS_WAREHOUSE_ID for YOUR workspace.
#   4. Add a required-reviewer protection rule to the `production` environment.
#
# The demo deploys synthetic data only. Never point it at real contact-centre recordings.

name: Deploy

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

concurrency:
  group: production-deploy
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ${{ vars.DATABRICKS_RUNNER || 'ubuntu-latest' }}
    environment: production
    env:
      DATABRICKS_HOST: ${{ vars.DATABRICKS_HOST }}
      DATABRICKS_CLIENT_ID: ${{ vars.DATABRICKS_CLIENT_ID }}
      DATABRICKS_AUTH_TYPE: github-oidc
      BUNDLE_VAR_warehouse_id: ${{ vars.DATABRICKS_WAREHOUSE_ID }}
      BUNDLE_VAR_runtime_service_principal_name: ${{ vars.DATABRICKS_RUNTIME_CLIENT_ID }}
      BUNDLE_VAR_deploy_service_principal_name: ${{ vars.DATABRICKS_CLIENT_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - uses: databricks/setup-cli@main
      - name: Validate production bundle
        run: databricks bundle validate -t prod
      - name: Ensure the parked PT endpoint exists
        run: >-
          uv run python scripts/manage_pt_endpoint.py
          --units 0
          --runtime-principal "${{ vars.DATABRICKS_RUNTIME_CLIENT_ID }}"
      - name: Deploy production bundle
        run: databricks bundle deploy -t prod
      - name: Grant runtime access to deployed notebooks
        run: |
          pipeline_id="$(
            databricks bundle summary -t prod --output json |
              jq -r '.resources.pipelines.transcript_pipeline.id'
          )"
          uv run python scripts/grant_bundle_file_access.py \
            --runtime-principal "${{ vars.DATABRICKS_RUNTIME_CLIENT_ID }}" \
            --pipeline-id "$pipeline_id"
      - name: Run end-to-end production workflow
        run: >-
          databricks bundle run -t prod connect_transcript_sentiment_job
          --params contacts=20,batch_label=production
